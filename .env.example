# ── Anantam EvalScore — server environment ──────────────────────
# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# Google Gemini API key (required). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Primary model — fast, cost-effective for structured scoring (optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Fallback model — deeper reasoning, used on rate limits or failures (optional, defaults to gemini-2.5-pro)
GEMINI_FALLBACK_MODEL=gemini-3-pro-preview

# API server port (optional, defaults to 8787)
PORT=8787

# ── Google Drive internal archival (OPTIONAL) ───────────────────
# Purely internal, best-effort archival of tool results. If NONE of these are
# set, archival is silently disabled and the app is completely unaffected.
# The user never sees Drive — failures are logged server-side only.
#
# In production (Vercel), paste the FULL service-account JSON as one value:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
#
# For local development, point to the key file instead (never commit it):
# GOOGLE_APPLICATION_CREDENTIALS=./anantam-engineering-b55a52678d5c.json
#
# Destination root Drive folder ID (e.g. an "Anantam Engineering" folder).
# Share it with the service-account email:
#   anantam-upload-service@anantam-engineering.iam.gserviceaccount.com
# Results are filed automatically as:
#   <root>/<Tool>/<YYYY>/<MM-DD>/<UploadId>/{metadata.json, analysis.json, thumbnail.webp, …}
# GDRIVE_ARCHIVE_FOLDER_ID=your-drive-folder-id

# IMPORTANT — service accounts have NO Drive storage of their own, so they
# cannot OWN files in a personal *My Drive* folder. Symptom: folders get
# created but every file upload fails with 403 "storageQuotaExceeded".
# Choose ONE of these so uploads have somewhere to live:
#   (A) Put GDRIVE_ARCHIVE_FOLDER_ID inside a SHARED DRIVE and add the service
#       account as Content Manager. Files are owned by the Shared Drive. (Best.)
#   (B) Impersonate a Workspace user who has storage, via domain-wide
#       delegation (enable DWD for the SA, authorize the Drive scope), then set:
# GDRIVE_IMPERSONATE_SUBJECT=you@your-workspace-domain.com
