# ── Anantam EvalScore — server environment ──────────────────────
# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# Google Gemini API key (required). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Primary model — fast, cost-effective for structured scoring (optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Fallback model — deeper reasoning, used on rate limits or failures (optional, defaults to gemini-2.5-pro)
GEMINI_FALLBACK_MODEL=gemini-3-pro-preview

# API server port (optional, defaults to 8787)
PORT=8787

# ── Google Drive internal archival (OPTIONAL) ───────────────────
# Purely internal, best-effort archival of tool results. If NONE of these are
# set, archival is silently disabled and the app is completely unaffected.
# The user never sees Drive — failures are logged server-side only.
#
# AUTH: OAuth 2.0 as a PERSONAL GMAIL account (via a refresh token). Uploads
# are owned by that Gmail user and use the account's own Drive storage — this
# is what avoids the service-account "storageQuotaExceeded" limit on personal
# My Drive folders.
#
# ONE-TIME SETUP: generate the refresh token with the helper script:
#   node apps/evalscore/scripts/get-drive-refresh-token.mjs <client_secret.json>
# It prints GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN —
# paste them into Vercel (Project → Settings → Environment Variables).
#
# GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# GOOGLE_REFRESH_TOKEN=your-refresh-token
#
# Destination root Drive folder ID, in that Gmail account's My Drive. Results
# are filed automatically as:
#   <root>/<Tool>/<YYYY>/<MM-DD>/<UploadId>/{metadata.json, analysis.json, thumbnail.webp, …}
# GDRIVE_ARCHIVE_FOLDER_ID=your-drive-folder-id
